PORT=41873
VITE_PORT=41872
HOST=0.0.0.0
COOKIE_SECURE=false
SESSION_SECRET=replace-with-a-long-random-string
FEISHU_APP_ID=cli_xxxxxxxxxxxxx
FEISHU_APP_SECRET=xxxxxxxxxxxxxxxx
FEISHU_TENANT_KEY=tenant_xxxxxxxxxxxxx
FEISHU_REDIRECT_URI=http://localhost:41873/api/auth/feishu/callback
FRONTEND_URL=http://localhost:41873
# 默认启用 Caddy HTTPS；局域网 IP 模式不需要域名
CADDY_ENABLED=true
# 公网模式时填写域名；局域网模式可省略，默认使用 10.37.70.152
CADDY_DOMAIN=oauth.example.com
# 使用局域网 IP 时保持 true；使用公网域名时改为 false
CADDY_LAN=true
